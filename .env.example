# VibraCam production environment template
# Copy to .env.production locally if needed.
# NEVER commit real passwords, API keys, or database credentials.

NODE_ENV=production
PORT=10000
PUBLIC_URL=https://vibracam.com
CLIENT_URL=https://vibracam.com

# MySQL / Aiven
# Example format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
DATABASE_URL=

# Local authentication
# Generate a random secret of at least 64 characters.
JWT_SECRET=
OWNER_EMAIL=vibracam.2026@gmail.com

# S3-compatible object storage
# AWS S3: leave S3_ENDPOINT empty.
# Cloudflare R2 / Backblaze B2 / MinIO: set the provider endpoint.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. If empty, files are served through /storage/<key> using signed URLs.
S3_PUBLIC_BASE_URL=

# Optional AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional Google Maps
GOOGLE_MAPS_API_KEY=

# Optional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional Render reverse proxy trust
TRUST_PROXY=1
