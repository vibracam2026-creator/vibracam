# VibraCam - independent production environment
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://your-domain.example
CLIENT_URL=https://your-domain.example

# Authentication
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_PLUS_CHARACTER_SECRET
OWNER_EMAIL=vibracam.2026@gmail.com

# MySQL / Aiven / PlanetScale-compatible
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED

# File storage: use S3-compatible storage in production (recommended)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Local fallback:
# LOCAL_STORAGE_DIR=/app/data/storage

# Email
RESEND_API_KEY=
EMAIL_FROM=VibraCam <noreply@your-domain.example>

# Optional AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Google Maps
GOOGLE_MAPS_API_KEY=

# Optional WebRTC TURN
# TURN_SERVER_URL=turn:your-turn-server.example:3478
# TURN_USERNAME=
# TURN_PASSWORD=
